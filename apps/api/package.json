{
  "name": "@health-tracker/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "openapi": "tsx src/openapi.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:lambda": "bash scripts/build-lambda.sh"
  },
  "dependencies": {
    "@fastify/aws-lambda": "^6.4.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@health-tracker/shared": "*",
    "better-sqlite3": "^11.7.0",
    "drizzle-orm": "^0.38.2",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^4.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
